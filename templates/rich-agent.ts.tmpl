import { Type, type FlueContext, type ToolDef } from '@flue/sdk/client';
import * as v from 'valibot';

export const triggers = { webhook: true };

interface Payload {
	question: string;
}

export default async function ({ init, payload }: FlueContext<Payload>) {
	// Custom tool: simple arithmetic for demonstration.
	const calculator: ToolDef = {
		name: 'calculator',
		description: 'Perform arithmetic. Returns the numeric result as a string.',
		parameters: Type.Object({
			expression: Type.String({ description: 'A math expression like "2 + 3"' }),
		}),
		execute: async (args) => {
			const expr = args.expression as string;
			return String(Function(`"use strict"; return (${expr})`)());
		},
	};

	const agent = await init({
		model: 'anthropic/claude-haiku-4-5',
		sandbox: 'empty',
	});
	const session = await agent.session();

	const result = await session.prompt(payload.question, {
		role: '{{ROLE}}',
		tools: [calculator],
		result: v.object({
			answer: v.string(),
			usedCalculator: v.boolean(),
		}),
	});

	return result;
}
