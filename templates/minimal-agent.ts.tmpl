import type { FlueContext } from '@flue/sdk/client';

interface Payload {
	question?: string;
}

export const triggers = { webhook: true };

export default async function ({ init, payload }: FlueContext<Payload>) {
	const agent = await init({ model: 'anthropic/claude-haiku-4-5' });
	const session = await agent.session();

	// Falls back to the build-time default prompt when the caller doesn't
	// pass a `question`. Shows how to read ctx.payload safely.
	const prompt = payload?.question ?? '{{PROMPT}}';
	const result = await session.prompt(prompt);
	return { text: result.text };
}
