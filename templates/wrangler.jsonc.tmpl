{
	// Cloudflare Workers config for a Flue workspace.
	// Run `flue build --target cloudflare` to merge this with Flue's required additions
	// (DO bindings + migrations) into dist/wrangler.jsonc.

	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "{{NAME}}",
	"main": "dist/_entry.ts",

	// Flue requires compat date >= 2026-04-01 and the nodejs_compat flag.
	"compatibility_date": "2026-04-01",
	"compatibility_flags": ["nodejs_compat"],

	// Per-agent DO bindings are added automatically by Flue.
	// If you use sandboxes, declare the Sandbox class here:
	"durable_objects": {
		"bindings": [
			// {
			//   "name": "Sandbox",
			//   "class_name": "Sandbox"
			// }
		]
	},

	// If using sandboxes, also declare the container:
	// "containers": [
	//   {
	//     "name": "Sandbox",
	//     "class_name": "Sandbox",
	//     "image": "cloudflare/sandbox"
	//   }
	// ],

	// Cron triggers — Flue stores cron metadata in the manifest;
	// you wire them here for the platform to actually schedule them.
	// "triggers": {
	//   "crons": ["0 9 * * *"]
	// },

	"observability": {
		"enabled": true
	}
}
