{
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|clear|compact",
				"hooks": [
					{
						"type": "command",
						"command": "node",
						"args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs"],
						"timeout": 15
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "node",
						"args": ["${CLAUDE_PLUGIN_ROOT}/scripts/lint-flue-file.mjs"],
						"timeout": 30
					}
				]
			}
		]
	}
}
